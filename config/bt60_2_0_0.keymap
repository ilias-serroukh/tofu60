#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/backlight.h>

#define LINUX 0
#define MAC 1
#define FN 2

&caps_word {
  continue-list = <UNDERSCORE MINUS BACKSPACE>;
  mods = <MOD_LSFT>;
};

/ {
  chosen {
    zmk,physical-layout = &layout_60_all1u;
  };

  macros {
    linux_mode: linux_mode {
      label = "LINUX_MODE";
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      wait-ms = <0>;
      tap-ms = <0>;
      bindings
        = <&macro_tap &to LINUX>
        , <&macro_tap &rgb_ug RGB_ON>
        , <&macro_tap &rgb_ug RGB_EFS_CMD 0>
        , <&macro_tap &rgb_ug RGB_COLOR_HSB(220,25,70)>;
    };

    mac_mode: mac_mode {
      label = "MAC_MODE";
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      wait-ms = <0>;
      tap-ms = <0>;
      bindings
        = <&macro_tap &to MAC>
        , <&macro_tap &rgb_ug RGB_ON>
        , <&macro_tap &rgb_ug RGB_EFS_CMD 0>
        , <&macro_tap &rgb_ug RGB_COLOR_HSB(300,100,80)>;
    };

    tty1: tty1 {
      label = "TTY1";
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      wait-ms = <20>;
      tap-ms = <20>;
      bindings
        = <&macro_press &kp LCTRL &kp LALT>
        , <&macro_tap &kp F1>
        , <&macro_release &kp LALT &kp LCTRL>;
    };

    tty2: tty2 {
      label = "TTY2";
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      wait-ms = <20>;
      tap-ms = <20>;
      bindings
        = <&macro_press &kp LCTRL &kp LALT>
        , <&macro_tap &kp F2>
        , <&macro_release &kp LALT &kp LCTRL>;
    };

    tty3: tty3 {
      label = "TTY3";
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      wait-ms = <20>;
      tap-ms = <20>;
      bindings
        = <&macro_press &kp LCTRL &kp LALT>
        , <&macro_tap &kp F3>
        , <&macro_release &kp LALT &kp LCTRL>;
    };

    tty4: tty4 {
      label = "TTY4";
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      wait-ms = <20>;
      tap-ms = <20>;
      bindings
        = <&macro_press &kp LCTRL &kp LALT>
        , <&macro_tap &kp F4>
        , <&macro_release &kp LALT &kp LCTRL>;
    };

    tty5: tty5 {
      label = "TTY5";
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      wait-ms = <20>;
      tap-ms = <20>;
      bindings
        = <&macro_press &kp LCTRL &kp LALT>
        , <&macro_tap &kp F5>
        , <&macro_release &kp LALT &kp LCTRL>;
    };

    tty6: tty6 {
      label = "TTY6";
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      wait-ms = <20>;
      tap-ms = <20>;
      bindings
        = <&macro_press &kp LCTRL &kp LALT>
        , <&macro_tap &kp F6>
        , <&macro_release &kp LALT &kp LCTRL>;
    };

    tty7: tty7 {
      label = "TTY7";
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      wait-ms = <20>;
      tap-ms = <20>;
      bindings
        = <&macro_press &kp LCTRL &kp LALT>
        , <&macro_tap &kp F7>
        , <&macro_release &kp LALT &kp LCTRL>;
    };

    tty8: tty8 {
      label = "TTY8";
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      wait-ms = <20>;
      tap-ms = <20>;
      bindings
        = <&macro_press &kp LCTRL &kp LALT>
        , <&macro_tap &kp F8>
        , <&macro_release &kp LALT &kp LCTRL>;
    };

    tty9: tty9 {
      label = "TTY9";
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      wait-ms = <20>;
      tap-ms = <20>;
      bindings
        = <&macro_press &kp LCTRL &kp LALT>
        , <&macro_tap &kp F9>
        , <&macro_release &kp LALT &kp LCTRL>;
    };

    ctrl_alt_del: ctrl_alt_del {
      label = "CTRL_ALT_DELETE";
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      wait-ms = <20>;
      tap-ms = <20>;
      bindings
        = <&macro_press &kp LCTRL &kp LALT>
        , <&macro_tap &kp DEL>
        , <&macro_release &kp LALT &kp LCTRL>;
    };

    gpg: gpg {
      label = "GPG";
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      bindings
        = <&macro_tap &kp N7 &kp N4 &kp N8 &kp N0 &kp N5 &kp N2 &kp N5>;
    };
  };

	behaviors {

		ht: hold-tap {
			compatible = "zmk,behavior-hold-tap";
      label = "HOLD_TAP";
      #binding-cells = <2>;
      bindings = <&kp>, <&kp>;
			flavor = "hold-preferred";
			tapping-term-ms = <150>;
		};

    td: tap-dance {
			compatible = "zmk,behavior-tap-dance";
      label = "TAP_DANCE_CAPS_WORD";
      #binding-cells = <0>;
			tapping-term-ms = <150>;
      bindings = <&kp LSHFT>, <&caps_word>;
    };

    td_tty1: tap-dance-tty1 {
      compatible = "zmk,behavior-tap-dance";
      label = "TAP_DANCE_TTY1";
      #binding-cells = <0>;
      tapping-term-ms = <200>;
      bindings = <&kp F1>, <&tty1>;
    };

    td_tty2: tap-dance-tty2 {
      compatible = "zmk,behavior-tap-dance";
      label = "TAP_DANCE_TTY2";
      #binding-cells = <0>;
      tapping-term-ms = <200>;
      bindings = <&kp F2>, <&tty2>;
    };

    td_tty3: tap-dance-tty3 {
      compatible = "zmk,behavior-tap-dance";
      label = "TAP_DANCE_TTY3";
      #binding-cells = <0>;
      tapping-term-ms = <200>;
      bindings = <&kp F3>, <&tty3>;
    };

    td_tty4: tap-dance-tty4 {
      compatible = "zmk,behavior-tap-dance";
      label = "TAP_DANCE_TTY4";
      #binding-cells = <0>;
      tapping-term-ms = <200>;
      bindings = <&kp F4>, <&tty4>;
    };

    td_tty5: tap-dance-tty5 {
      compatible = "zmk,behavior-tap-dance";
      label = "TAP_DANCE_TTY5";
      #binding-cells = <0>;
      tapping-term-ms = <200>;
      bindings = <&kp F5>, <&tty5>;
    };

    td_tty6: tap-dance-tty6 {
      compatible = "zmk,behavior-tap-dance";
      label = "TAP_DANCE_TTY6";
      #binding-cells = <0>;
      tapping-term-ms = <200>;
      bindings = <&kp F6>, <&tty6>;
    };

    td_tty7: tap-dance-tty7 {
      compatible = "zmk,behavior-tap-dance";
      label = "TAP_DANCE_TTY7";
      #binding-cells = <0>;
      tapping-term-ms = <200>;
      bindings = <&kp F7>, <&tty7>;
    };

    td_tty8: tap-dance-tty8 {
      compatible = "zmk,behavior-tap-dance";
      label = "TAP_DANCE_TTY8";
      #binding-cells = <0>;
      tapping-term-ms = <200>;
      bindings = <&kp F8>, <&tty8>;
    };

    td_tty9: tap-dance-tty9 {
      compatible = "zmk,behavior-tap-dance";
      label = "TAP_DANCE_TTY9";
      #binding-cells = <0>;
      tapping-term-ms = <200>;
      bindings = <&kp F9>, <&tty9>;
    };

    td_del: tap-dance-delete {
      compatible = "zmk,behavior-tap-dance";
      label = "TAP_DANCE_DELETE";
      #binding-cells = <0>;
      tapping-term-ms = <200>;
      bindings = <&kp DEL>, <&ctrl_alt_del>;
    };

	};

  keymap {
    compatible = "zmk,keymap";
    default_layer {
        // --------------------------------------------------------------------------------------------
        // | ESC |  1  |  2  |  3  |  4  |  5  |  6  |  7  |  8  |  9  |  0  |  -  |  =  |BKSP | BSPC |
        // | TAB   |  Q  |  W  |  E  |  R  |  T  |  Y  |  U  |  I  |  O  |  P  |  [  |  ]  |    \     |
        // | CAPS   |  A  |  S  |  D  |  F  |  G  |  H  |  J  |  K  |  L  |  ;  |  '  |     ENTER     |
        // | SHFT  |NONE|  Z  |  X  |  C  |  V  |  B  |  N  |  M  |  ,  |  .  | /   | SHFT | UP | FN  |
        // |  CTL  |  WIN  |  ALT  |           SPACE              | RALT| CTRL | LEFT | DOWN | RIGHT  |
        // --------------------------------------------------------------------------------------------
      bindings = <
        &kp GRAVE &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp  N8   &kp  N9 &kp  N0  &kp MINUS &kp EQUAL &kp BSPC &kp BSPC
        &kp TAB  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp  I    &kp  O  &kp  P   &kp LBKT &kp RBKT  &kp BSLH
        &ht LCTRL ESC  &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp  K    &kp  L  &kp SEMI &kp SQT           &kp RET
        &td &none  &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA &kp DOT &ht RSHFT FSLH    &ht RSHFT FSLH  &kp UP &mo FN
        &kp LCTRL &kp LGUI &kp LALT            &kp SPACE                           &kp RALT &kp RCTRL &kp LEFT &kp DOWN &kp RIGHT
      >;
      sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
    };
    mac_layer {
        // --------------------------------------------------------------------------------------------
        // Transparent except for modifiers: Ctrl Option Command / Command Option.
        // --------------------------------------------------------------------------------------------
      bindings = <
        &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
        &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
        &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
        &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &mo FN
        &kp LCTRL &kp LALT &kp LGUI            &trans                           &kp RGUI &kp RALT &trans &trans &trans
      >;
      sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
    };
    raise {
        // ------------------------------------------------------------------------------------------
        // |GRAVE|F1/T1|F2/T2|F3/T3|F4/T4|F5/T5|F6/T6|F7/T7|F8/T8|F9/T9| F10 | F11 | F12 |D/CAD|D/CAD|
        // | TAB  |  Q  |  W  |  E  | HUI | HUD |  Y  |  U  | INS |  O  |PSCRN| SLCK| P_B | RGB_TOG  |
        // | CAPS  |  A  |  S  |  D  | BRI | BRD |  H  |  J  |  K  |  L  | HOME| PGUP|      BOOT     |
        // | SHFT |NONE|VOLDN|VOLUP|MUTE|BLINC|BLDEC|  N  |  M  |  ,  | END | PGDN | SHFT|BL_TOG| FN |
        // | LINUX | NONE |  MAC  |           SPACE              | RALT| CTRL | BT_PRV |BT_CLR| BT_NXT |
        // ------------------------------------------------------------------------------------------
      bindings = <
        &kp GRAVE &td_tty1 &td_tty2 &td_tty3 &td_tty4 &td_tty5 &td_tty6 &td_tty7 &td_tty8 &td_tty9 &kp  F10  &kp F11 &kp F12   &td_del &td_del
        &gpg &trans &trans &trans &rgb_ug RGB_HUI &rgb_ug RGB_HUD &trans &trans &kp INS &trans &kp PSCRN &kp SLCK &kp PAUSE_BREAK &rgb_ug RGB_TOG
        &trans    &trans &trans &trans &rgb_ug RGB_BRI &rgb_ug RGB_BRD &trans &trans &trans &trans &kp HOME  &kp PG_UP   &bootloader
        &trans &none &kp C_VOL_DN &kp C_VOL_UP &kp C_MUTE &bl BL_INC &bl BL_DEC &trans &trans &trans &kp END &kp PG_DN &trans &bl BL_TOG &trans
        &linux_mode &none  &mac_mode              &trans                            &trans  &trans &bt BT_PRV   &bt BT_CLR &bt BT_NXT
      >;
      sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
    };
  };
};
