#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
  chosen {
    zmk,physical-layout = &layout_60_all1u;
  };

  keymap {
    compatible = "zmk,keymap";

    default_layer {
      // Simple single-layer Mac layout. No combos, hold-taps, macros, RGB, Bluetooth, or reset keys.
      bindings = <
        &kp ESC   &kp N1    &kp N2    &kp N3    &kp N4    &kp N5    &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp MINUS &kp EQUAL &kp BSPC  &kp DEL
        &kp TAB   &kp Q     &kp W     &kp E     &kp R     &kp T     &kp Y     &kp U     &kp I     &kp O     &kp P     &kp LBKT  &kp RBKT  &kp BSLH
        &kp CAPS  &kp A     &kp S     &kp D     &kp F     &kp G     &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp SQT             &kp RET
        &kp LSHFT &kp LSHFT &kp Z     &kp X     &kp C     &kp V     &kp B     &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp RSHFT &kp UP    &kp RSHFT
        &kp LCTRL &kp LALT  &kp LGUI                      &kp SPACE                                &kp RGUI  &kp RALT  &kp LEFT  &kp DOWN  &kp RIGHT
      >;
    };
  };
};
